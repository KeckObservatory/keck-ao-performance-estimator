# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/

# Virtual environments
env/
venv/
.env

# Editor files
.vscode/
.idea/

# ---- Runtime caches & scratch outputs ----
# (Deliberately scoped: the frozen regression REFERENCES under regress/ref/ and
#  the harness inputs under regress/data/ MUST stay tracked -- do NOT add a
#  blanket *.png / *.csv / *.fits ignore, which would silently break
#  `harness.py check` on a fresh clone.)

# KAON doc figures are regenerated by regress/capture_kaon_figs.py and stay
# local (PyPI scrub 2026-08-07: GUI screenshots may show loaded field data)
sr_estimator/regress/kaon_update_figs/

# MKWC seeing-profile cache pulled at runtime
sr_estimator/mkwc_cache/

# Regenerated harness comparison outputs (rebuilt by `harness.py check`)
sr_estimator/regress/test/

# Scratch renders / exports / FITS written next to the tool (one level only)
sr_estimator/*.png
sr_estimator/*.csv
sr_estimator/*.fits

# examples/ holds only SYNTHETIC or PUBLIC-KOA fixtures/demos (PyPI scrub,
# 2026-08-07: real observing starlists, session exports, and field imagery
# must never be committed here again).  synthetic_k1lgs.lst is generated by
# make_synthetic_starlist.py; N2.20210821_42637.fits is a public KOA frame
# (M15 core field, Kp, narrow camera, 2021)
# (see fetch_koa_examples.py).  On-sky EXPERIMENTS -- analyses, reports,
# raw-frame sets -- live in the separate keck_ao_experiments repo (split
# 2026-07-25); anything real dropped here stays local:
sr_estimator/examples/*.fits
!sr_estimator/examples/N2.20210821_42637.fits
sr_estimator/examples/*.lst
!sr_estimator/examples/synthetic_k1lgs.lst
sr_estimator/examples/*session*
sr_estimator/examples/lev0/
sr_estimator/examples/*.tbl

# Loose dev screenshots / exports at the regress root (tests regenerate their
# own; the frozen refs live one level down in regress/ref/ and stay tracked)
sr_estimator/regress/*.png

# Synthetic FITS the gui tests write next to themselves (normally cleaned up)
sr_estimator/regress/synth_*.fits
sr_estimator/regress/*.fits
sr_estimator/regress/*.csv

# runtime MKWC cache at the repo root (created when tools run from here)
/mkwc_cache/
